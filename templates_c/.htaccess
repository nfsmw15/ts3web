# Apache: deny all direct access - this directory holds compiled Smarty
# templates (raw PHP), never anything meant to be requested directly.
# Has no effect on nginx - see README for the equivalent nginx `location` block.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
